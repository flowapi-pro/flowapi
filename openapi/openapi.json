       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "description": "Wrong idInstance or apiTokenInstance"
     },
     "402": {
      "description": "Trial ended or number not covered by the plan"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "webhookUrl": {
          "type": "string"
         },
         "webhookUrlToken": {
          "type": "string"
         },
         "incomingWebhook": {
          "type": "string",
          "enum": [
           "yes",
           "no"
          ]
         },
         "outgoingWebhook": {
          "type": "string",
          "enum": [
           "yes",
           "no"
          ]
         },
         "stateWebhook": {
          "type": "string",
          "enum": [
           "yes",
           "no"
          ]
         }
        },
        "required": []
       }
      }
     }
    }
   }
  },
  "/waInstance{idInstance}/sendMessage/{apiTokenInstance}": {
   "post": {
    "operationId": "sendMessage",
    "summary": "Send a text message",
    "tags": [
     "Sending"
    ],
    "parameters": [
     {
      "$ref": "#/components/parameters/idInstance"
     },
     {
      "$ref": "#/components/parameters/apiTokenInstance"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "idMessage": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Wrong idInstance or apiTokenInstance"
     },
     "402": {
      "description": "Trial ended or number not covered by the plan"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "chatId": {
          "type": "string",
          "description": "Phone with country code + '@c.us' (e.g. 972501234567@c.us) or group id '\u2026@g.us'",
          "example": "972501234567@c.us"
         },
         "message": {
          "type": "string"
         },
         "quotedMessageId": {
          "type": "string"
         }
        },
        "required": [
         "chatId",
         "message"
        ]
       }
      }
     }
    }
   }
  },
