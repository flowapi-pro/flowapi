{
 "openapi": "3.1.0",
 "info": {
  "title": "Flow API \u2014 WhatsApp API",
  "version": "1.0.0",
  "description": "Green-API-compatible WhatsApp HTTP API. Every request is /waInstance{idInstance}/{method}/{apiTokenInstance}. Get your idInstance and apiTokenInstance in the Flow API console.",
  "contact": {
   "name": "Flow API",
   "url": "https://flowapi.pro",
   "email": "contact@flowapi.pro"
  },
  "termsOfService": "https://flowapi.pro/legal/terms"
 },
 "servers": [
  {
   "url": "https://flowapi.pro"
  }
 ],
 "paths": {
  "/waInstance{idInstance}/getStateInstance/{apiTokenInstance}": {
   "get": {
    "operationId": "getStateInstance",
    "summary": "Connection state of the number",
    "tags": [
     "Account"
    ],
    "parameters": [
     {
      "$ref": "#/components/parameters/idInstance"
     },
     {
      "$ref": "#/components/parameters/apiTokenInstance"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "stateInstance": {
           "type": "string",
           "enum": [
            "authorized",
            "notAuthorized",
            "starting",
            "blocked"
           ]
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Wrong idInstance or apiTokenInstance"
     },
     "402": {
      "description": "Trial ended or number not covered by the plan"
     }
    }
   }
  },
